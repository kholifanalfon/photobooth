# ==============================================================================
# PHOTOBOOTH APPLICATION CONFIGURATION TEMPLATE
# ==============================================================================
# Salin file ini menjadi `.env` sebelum menjalankan aplikasi:
# cp .env.example .env
#
# File ini memuat 2 kelompok konfigurasi:
# 1. Konfigurasi Server Dev (Lokal / Native Node.js tanpa Docker)
# 2. Konfigurasi Server Docker (Production / Containerized Environment)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. KONFIGURASI SERVER DEV (LOKAL NATIVE NODE.JS)
# ------------------------------------------------------------------------------
# Port server backend Express (lokal)
PORT=5025

# Port client Vite frontend (lokal)
VITE_PORT=5125
CLIENT_PORT=5125

# URL koneksi database PostgreSQL lokal (jika memakai native postgres)
# Catatan: port 5432 hanya diakses di host lokal
DATABASE_URL="postgresql://postgres:P%40ssw0rd@localhost:5432/photobooth?schema=public"
DATABASE_URL_TEST="postgresql://postgres:P%40ssw0rd@localhost:5432/photobooth_test?schema=public"

# URL routing dev
CLIENT_URL="http://localhost:5125"
PUBLIC_HOST_URL="http://localhost:5025"
VITE_API_BASE_URL="http://localhost:5025"

# ------------------------------------------------------------------------------
# 2. KONFIGURASI SERVER DOCKER (PRODUCTION / DOCKER COMPOSE)
# ------------------------------------------------------------------------------
# Mode Node.js pada container Docker (production / development)
DOCKER_NODE_ENV=production

# Konfigurasi Database PostgreSQL Docker (Port 5432 TIDAK diekspor ke host / publik)
# Hanya dapat diakses secara privat di dalam docker network internal
DOCKER_DB_USER=postgres
DOCKER_DB_PASSWORD=photobooth_secret
DOCKER_DB_NAME=photobooth
DOCKER_DATABASE_URL="postgresql://postgres:photobooth_secret@db:5432/photobooth?schema=public"

# Konfigurasi Server Backend Docker (Express API)
DOCKER_SERVER_HOST_PORT=5025
DOCKER_SERVER_PORT=5025
DOCKER_PUBLIC_HOST_URL="http://localhost:5025"
DOCKER_UPLOADS_DIR="uploads"
DOCKER_SERVER_CMD="npm start"

# Konfigurasi Client Frontend Docker (Vite React)
DOCKER_CLIENT_HOST_PORT=5173
DOCKER_CLIENT_PORT=5173
DOCKER_CLIENT_URL="http://localhost:5173"
DOCKER_BACKEND_HOST=server
DOCKER_BACKEND_PROXY_TARGET="http://server:5025"
# Kosongkan DOCKER_VITE_API_BASE_URL agar request /api otomatis di-proxy oleh client container ke server
DOCKER_VITE_API_BASE_URL=
DOCKER_CLIENT_CMD="npm run dev -- --host 0.0.0.0 --port 5173"
