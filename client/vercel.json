{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://photobooth-smstgw.fly.dev/api/:path*"
    },
    {
      "source": "/uploads/:path*",
      "destination": "https://photobooth-smstgw.fly.dev/uploads/:path*"
    },
    {
      "source": "/frames/:path*",
      "destination": "https://photobooth-smstgw.fly.dev/frames/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
