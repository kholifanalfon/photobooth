{
  "name": "photobooth-server",
  "version": "1.0.0",
  "scripts": {
    "dev": "nodemon --watch src --ignore data/ --ignore uploads/ --ignore prisma/ src/index.js",
    "start": "node src/index.js",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
    "pretest": "node --env-file=.env.test test/cleanup.js",
    "test": "node --env-file=.env.test --test --test-concurrency=1 test/**/*.test.js",
    "posttest": "node --env-file=.env.test test/cleanup.js",
    "test:cleanup": "node --env-file=.env.test test/cleanup.js",
    "test:db:push": "node --env-file=.env.test ./node_modules/.bin/prisma db push"
  },
  "dependencies": {
    "@prisma/client": "^5.14.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "multer": "^1.4.5-lts.1",
    "qrcode": "^1.5.3"
  },
  "devDependencies": {
    "nodemon": "^3.1.0",
    "prisma": "^5.14.0",
    "supertest": "^7.0.0"
  }
}
